# Telegram Bot token (get from @BotFather)
BOT_TOKEN=

# MongoDB connection string (use localhost for running outside Docker, or mongodb://mongo:27017 for Docker Compose)
MONGODB_CONNECTION_STRING=mongodb://localhost:27017/picture_studio

# Environment (development | production)
NODE_ENV=development

# Optional comma-separated Telegram user IDs allowed to use the bot (leave empty to allow everyone)
ALLOWED_TELEGRAM_IDS=
