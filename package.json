{
  "name": "@gabrielrufino/picture-studio-bot",
  "version": "2.0.1",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "description": "A Telegram bot for processing and manipulating images",
  "author": "Gabriel Rufino <contato@gabrielrufino.com>",
  "license": "UNLICENSED",
  "main": "dist/index.cjs",
  "scripts": {
    "build": "tsdown src/index.ts --format cjs",
    "prebuild": "pnpm run build:check",
    "build:check": "tsc --noEmit",
    "build:watch": "tsdown src/index.ts --watch",
    "lint": "eslint ./src",
    "lint:fix": "pnpm run lint --fix",
    "start": "node .",
    "start:dev": "tsx watch --env-file=.env src/index.ts",
    "test": "vitest run",
    "test:cov": "pnpm run test --coverage",
    "test:watch": "vitest",
    "test:mutate": "stryker run",
    "prepare": "if [ \"$NODE_ENV\" != \"production\" ]; then husky; fi"
  },
  "dependencies": {
    "@grammyjs/files": "1.2.0",
    "@grammyjs/ratelimiter": "1.2.1",
    "@grammyjs/runner": "2.0.3",
    "@grammyjs/storage-mongodb": "2.6.0",
    "grammy": "1.45.1",
    "ipaddr.js": "^2.5.0",
    "mongodb": "6.21.0",
    "node-cron": "4.6.0",
    "pino": "9.14.0",
    "sharp": "^0.35.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.3.0",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@faker-js/faker": "8.4.1",
    "@gabrielrufino/types": "1.2.1",
    "@mapbox/node-pre-gyp": "2.0.3",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/typescript-checker": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node-cron": "^3.0.11",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.4",
    "husky": "9.1.7",
    "mongodb-memory-server": "10.4.3",
    "pino-pretty": "13.1.3",
    "tsdown": "0.22.14",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "4.1.10"
  }
}
